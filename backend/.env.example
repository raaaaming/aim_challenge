# ─── Supabase ────────────────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=place-images

# ─── LLM (무료 등급) ─────────────────────────────────────────────────────
# gemini | groq | openrouter | rule(키 없이 내장 규칙 엔진)
LLM_PROVIDER=gemini
# Google AI Studio 무료 키: https://aistudio.google.com/apikey
LLM_API_KEY=
# 비워두면 provider 별 기본 무료 모델 사용
LLM_MODEL=

# ─── 서버 ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
